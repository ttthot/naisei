<% provide(:title, "Log in") %>

<div class="max-w-md mx-auto py-12">
  <div class="card card-border bg-base-100 shadow-2xl rounded-2xl mt-6">
    <div class="card-body p-8">
      <%= form_with(url: login_path, scope: :session) do |f| %>
        <div class="space-y-6">
          <div class="form-control">
            <%= f.email_field :email,
                          class: "input input-bordered w-full text-lg py-3 px-4",
                          placeholder: "メールアドレス" %>
          </div>

          <div class="form-control">
            <%= f.password_field :password,
                             class: "input input-bordered w-full text-lg py-3 px-4",
                             placeholder: "パスワード" %>
          </div>

          <div class="form-control">
            <%= f.submit "ログイン",
                     class:
                       "btn btn-primary btn-lg w-full text-lg font-bold btn-shadow hover:scale-105 transition" %>
          </div>
        </div>
      <% end %>

      <p class="mt-4 text-center tracking-wide text-base">
        <%= link_to "登録はこちらから！", signup_path, class: "link link-primary hover:underline" %>
      </p>
    </div>
  </div>
</div>
