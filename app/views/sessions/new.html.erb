<% provide(:title, "Log in") %>
<%# `my-6` クラスは上下に1.5rem (24px) のマージンを追加します。 %>
<h1 class="text-2xl font-bold text-center my-6">Log in</h1>

<div class="max-w-md mx-auto">
  <%# `max-w-md` クラスは最大幅を28rem (448px) に設定し、`mx-auto` クラスは左右のマージンを自動で調整して中央揃えにします。 %>
  <%# RailsのHTMLフォームのデフォルトメソッドはPOSTです。明示的に:method => :getを指定しない限り、POSTリクエスト。%>
  <%= form_with(url: login_path, scope: :session, class: "space-y-4") do |f| %>
    <div class="form-control">
      <%= f.label :email, class: "label" %>
      <%= f.email_field :email, class: 'input input-bordered w-full' %>
    </div>

    <div class="form-control">
      <%= f.label :password, class: "label" %>
      <%= f.password_field :password, class: 'input input-bordered w-full' %>
    </div>

    <div class="form-control mt-6">
      <%= f.submit "Log in", class: "btn btn-primary w-full" %>
    </div>
  <% end %>
<%# /signupというURLパスへのGETリクエストをusersコントローラーのnewアクションにルーティングするよう指定しています。 %>
  <p class="mt-4 text-center"><%= link_to "登録はこちらから！", signup_path, class: "link link-primary" %></p>

</div>



