<% provide(:title, "Log in") %>
<h1>Log in</h1>

<div class="grid grid-cols-1 gap-4">
  <div class="max-w-md mx-auto">
    <%= form_with(url: login_path, scope: :session) do |f| %>

      <%= f.label :email %>
      <%= f.email_field :email, class: 'input input-bordered w-full' %>

      <%= f.label :password %>
      <%= f.password_field :password, class: 'input input-bordered w-full' %>

      <%= f.submit "Log in", class: "btn btn-primary mt-4" %>
    <% end %>

    <p>New user? <%= link_to "Sign up now!", signup_path %></p>
  </div>
  
  <div class="max-w-md mx-auto">
    <h2 class="text-lg font-bold mb-2">DaisyUI確認用</h2>
    <button class="btn btn-primary">daisyUI Button</button>
    
    <div class="card bg-base-100 shadow-xl mt-4">
      <div class="card-body">
        <h2 class="card-title">daisyUI Card!</h2>
        <p>If this card is styled correctly, daisyUI is working.</p>
      </div>
    </div>
  </div>
</div>



