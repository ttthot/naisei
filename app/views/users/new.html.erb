<% provide(:title, "Sign up") %>

<div class="max-w-md mx-auto py-12">
  <div class="card card-border bg-base-100 shadow-2xl rounded-2xl mt-6">
    <figure>
      <%= image_tag "naisei_hero.png",
      alt: "Naisei - ストレス解消サービス",
      # object-,,　はみ出し補正
      class: "w-full object-cover" %>
    </figure>
    <div class="card-body p-8">
      <h2 class="text-2xl font-bold mb-8 text-center font-sans tracking-wide">アカウント登録</h2>
      <%= form_with(model: @user) do |f| %>
        <div class="space-y-6">
          <%= render "shared/error_messages" %>
          <div class="form-control">
            <%= f.text_field :name,
                         class: "input input-bordered w-full text-lg py-3 px-4",
                         placeholder: "お名前" %>
          </div>
          <div class="form-control">
            <%= f.email_field :email,
                          class: "input input-bordered w-full text-lg py-3 px-4",
                          placeholder: "メールアドレス" %>
          </div>
          <div class="form-control">
            <%= f.password_field :password,
                             class: "input input-bordered w-full text-lg py-3 px-4",
                             placeholder: "パスワード（6文字以上）" %>
          </div>
          <div class="form-control">
            <%= f.password_field :password_confirmation,
                             class: "input input-bordered w-full text-lg py-3 px-4",
                             placeholder: "パスワード（確認）" %>
          </div>
          <div class="form-control">
            <%= f.submit "アカウントを作成",
                     class:
                       "btn btn-primary btn-lg w-full text-lg font-bold btn-shadow hover:scale-105 transition" %>
          </div>
        </div>
      <% end %>
      <p class="mt-6 text-center tracking-wide text-base">
        <%= link_to "ログインはこちらから", login_path, class: "link link-primary hover:underline" %>
      </p>
    </div>
  </div>
</div>
