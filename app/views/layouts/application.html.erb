<!DOCTYPE html>
<html data-theme="lemonade" lang="ja">
  <head>
    <title>Naisei</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload", preload: false %>

    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "application",
    "data-turbo-track": "reload",
    type: "module" %>
    <style>
       body {
      font-family: 'Zen Maru Gothic', 'Avenir', 'Hiragino Sans', 'Meiryo', sans-serif;
       line-height: 1.7;        /* 行間（1.7倍） */
      letter-spacing: 0.03em;  /* 文字間隔を少し広げる */
    }
    </style>
    <%#  Google Fonts %>
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;700&display=swap"
      rel="stylesheet"
    >
    <%# ハート,カレンダーなどのアイコン %>
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      rel="stylesheet"
    >
  </head>

  <body class="bg-base-100 text-base-content">

    <% if flash.any? %>
      <div
        <%# left1/2で画面半分スタートかつ、自身の幅の半分左ずらす %>
        class="
          fixed top-4 left-1/2 transform -translate-x-1/2 w-full max-w-md z-50
        "
      >
        <% flash.each do |message_type, message| %>
          <% key = message_type.to_s %>
          <%# TODO後で消すかどうか検討: 空のフラッシュメッセージ対策として message.present? 条件を追加 %>
          <% if (key == "notice" || key == "success") && message.present? %>
            <%# margin-top と margin-bottomに 0.5rem %>
            <div class="alert alert-success shadow-lg my-2">
              <span><%= message %></span>
            </div>
          <% elsif (key == "alert" || key == "danger" || key == "error") && message.present? %>
            <div class="alert alert-error shadow-lg my-2">
              <span><%= message %></span>
            </div>
          <% elsif message.present? %>
            <div class="alert alert-info shadow-lg my-2">
              <span><%= message %></span>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if Rails.env.development? %>
      <%# 以下２個は必要時に使う %>
      <%# <%= debug flash %>
      <%# <%= debug session %>
      <%# TODO開発用に表示するデバッグコード本番ようにするため削除している %>
      <%# <%= debug(params) %>

    <% end %>

    <%# 以下に子要素を挿入される %>
    <%# リクエスト、コントローラはアクションに対応するビューをレンダリング、まず本ファイルが呼ばれる、その後yieldを発見し挿入 %>
    <%= yield %>

  </body>
</html>
