<%# _likes_button.html..で %>
<%# 全体の構造を担当、ファイル内でいいね部品を呼び出す %>
<%# domidはヘルパーメソッド、一意のidをpostオブジェクトからー生成ーする　"第二引数_post_6" %>
<div
  id="<%= dom_id(post, "like_button") %>"
  class="flex items-center justify-center"
>
  <% like = current_user.likes.find_by(post: post) %>
  <%# いいねボタンが押されているのであれば %>
  <% if like %>
    <%# button to でフォーム（いいね投稿削除）＋ボタン（ハートがわだけ）を生成 %>
    <%# DELETE /posts/:post_id/likes/:id likes#destroy  post_like_path %>
    <%= button_to post_like_path(post, like), method: :delete, 
        class: "btn btn-circle btn-sm w-12 h-12 flex items-center justify-center", 
d        form: { data: { turbo_stream: true } } do %>
      <div class="flex flex-col items-center">
        <%# 赤色のハートアイコンを表示 %>
        <%# - fas: スタイル（塗りつぶしアイコン） %>
        <%# - fa-heart: Font Awesomeライブラリのハートアイコン %>
        <%# - text-red-500: Tailwind CSSの赤色（強度500）を適用 %>
        <i class="fas fa-heart text-red-500"></i>
        <span class="text-xs"><%= post.likes.count %></span>
      </div>
    <% end %>
    <%# いいねボタンがまだ押されていない %>
  <% else %>
    <%# POST   /posts/:post_id/likes     likes#create   post_likes_path %>
    <%= button_to post_likes_path(post), method: :post, 
        class: "btn btn-circle btn-outline btn-sm w-12 h-12 flex items-center justify-center", 
        form: { data: { turbo_stream: true } } do %>
      <div class="flex flex-col items-center">
        <i class="far fa-heart text-gray-500"></i>
        <span class="text-xs"><%= post.likes.count %></span>
      </div>
    <% end %>
  <% end %>
</div>
