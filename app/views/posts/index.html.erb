<%# 投稿一覧ページ全体を表示 %
<%# また本ファイルは別のファイルを呼びだしている、全体は三層構造になっている %>
  <%#いいね作成時@postを取得し一つのpostオブジェクトを取得し、_post.htmlを呼び出す %>

  <div class="max-w-4xl mx-auto px-4 py-6">

    <%# 🔽ここを置き換え %>
<i class="fa-solid fa-fire text-2xl" style="color: #f97316;"></i>

  <h2 class="text-xl font-bold">連続投稿記録</h2>

  <div class="mt-4 space-y-2">
    <p>現在: <%= @user.post_streak %>日連続</p>
    <p>最長記録: <%= @user.max_post_streak %>日</p>
  </div>

  <% if @user.post_streak > 0 && @user.post_streak == @user.max_post_streak %>
    <p class="mt-2 text-red-500">🎉 記録更新中！</p>
  <% end %>
</div>

    <%# タブナビゲーション %>
    <div class="tabs mb-6">
      <%= link_to "全体",
      posts_path,
      class: "tab tabs-border #{"tab-active" unless params[:scope]}" %>
      <%= link_to "自分の投稿",
      posts_path(scope: "mine"),
      class: "tab tabs-border #{"tab-active" if params[:scope] == "mine"}" %>
    </div>

    <h1 class="text-2xl font-bold text-center mb-6">投稿一覧</h1>

    <div class="flex justify-between items-center mb-6">
      <div>
        <% if @posts.empty? %>
          <p>まだ投稿がありません。</p>
        <% else %>
          <p>
            <%# @posts.countを削除した %>
            <%# 件の投稿があります %>
          </p>
        <% end %>
      </div>
    </div>

    <%# 投稿をリスト表示するエリア %>
    <div class="space-y-4" id="posts">
      <%# @postsに入っている投稿データ1つ1つについて自動的に部品テンプレート_post.htmlを使って繰り返し表示する %>
      <%# @post　＝ Post.allをコントローラーで確認し、Postクラスのオフジェクトの集まりと認識、render @posts 1件ずつパーシャルに渡す %>
      <%# ループ内でpostオブジェクトを発見、部品が入ったファイルは_post.htmlと予測、つまりコレクションレンダリング %>
      <%# 部品ファイル内のpost変数にループで扱っているオブジェクトPost id:1等を渡す %>
      <%# 全ループをここで繰り返す %>
      <%= render @posts %>
    </div>

    <%# ページネーションエリア %>
    <div class="mt-6 flex justify-end space-x-2">
      <%# 前へボタン %>
      <% if @has_previous_page %>
        <%# ルーティングヘルパーにscope: @scopeを追加　 /posts?パラメータ1=値1&パラメータ2=値2になる %>
        <%= link_to "前のページ",
        posts_path(page: @current_page - 1, scope: @scope),
        class: "btn btn-secondary" %>
      <% end %>

      <%# 次へボタン %>
      <% if @has_next_page %>
        <%= link_to "次のページ",
        posts_path(page: @current_page + 1, scope: @scope),
        class: "btn btn-secondary" %>
      <% end %>
    </div>

    <%= debug(@posts) if Rails.env.development? %>

  </div>
