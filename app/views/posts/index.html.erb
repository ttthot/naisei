<%# 投稿一覧ページ全体を表示 %
<%# また本ファイルは別のファイルを呼びだしている、全体は三層構造になっている %>
  <%#いいね作成時@postを取得し一つのpostオブジェクトを取得し、_post.htmlを呼び出す %>

  <div class="max-w-4xl mx-auto px-4 py-6">

    <h1 class="text-2xl font-bold text-center mb-6">投稿一覧</h1>

    <div class="flex justify-between items-center mb-6">
      <div>
        <% if @posts.empty? %>
          <p>まだ投稿がありません。</p>
        <% else %>
          <p>
            <%# @posts.countを削除した %>
            <%# 件の投稿があります %>
          </p>
        <% end %>
      </div>

    </div>

    <%# 投稿をリスト表示するエリア %>
    <div class="space-y-4" id="posts">
      <%# @post　＝ Post.allを確認し、Postクラスのオフジェクトの集まりと認識、render @posts 1件ずつパーシャルに渡す %>
      <%# ループ内でpostオブジェクトを発見、部品が入ったファイルは_post.htmlと予測、つまりコレクションレンダリング %>
      <%# 部品ファイル内のpost変数にループで扱っているオブジェクトPost id:1等を渡す %>
      <%# 全ループをここで繰り返す %>
      <%= render @posts %>
    </div>

    <%# ページネーションエリア %>
    <div class="mt-6 flex justify-end space-x-2">
      <%# 前へボタン %>
      <% if @has_previous_page %>
        <%= link_to "前のページ", posts_path(page: @current_page - 1), class: "btn btn-secondary" %>
      <% end %>
      <%# 次へボタン %>
      <% if @has_next_page %>
        <%= link_to "次のページ", posts_path(page: @current_page + 1), class: "btn btn-secondary" %>
      <% end %>

    </div>

    <%= debug(@posts) if Rails.env.development? %>

  </div>
