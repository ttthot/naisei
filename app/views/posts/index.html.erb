<%# 投稿一覧ページ全体を表示 %>
<%#いいね作成時@postを取得し一つのpostオブジェクトを取得し、_post.htmlを呼び出す %>
<%# _likes_button.html..で %>
<%# 全体の構造を担当、ファイナ内でいいね部品を呼び出す %>
<div class="max-w-4xl mx-auto px-4 py-6">
  <h1 class="text-2xl font-bold text-center mb-6">投稿一覧</h1>

  <div class="flex justify-between items-center mb-6">
    <div>
      <% if @posts.empty? %>
        <p>まだ投稿がありません。</p>
      <% else %>
        <p><%= @posts.count %>件の投稿があります</p>
      <% end %>
    </div>
    <div>
      <%= link_to "新規投稿", new_post_path, class: "btn btn-primary" %>
    </div>
  </div>

  <%# 投稿をリスト表示するエリア %>
  <div class="space-y-4" id="posts">
    <%# @post　＝ Post.allを確認し、Postクラスのオフジェクトの集まりと認識してループを展開し出す@ %>
    <%# ループ内でpostオブジェクトを発見部品が入ったファイルは_post.html,,と予測、つまりコレクションレンダリング>
    <%# 部品ファイルのpost変数にループで扱っているオブジェクトPost id:1等を渡す %>
    <%# 全ループをここで繰り返す %>
    <%= render @posts %>
  </div>
</div>