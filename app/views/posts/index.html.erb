<div class="max-w-4xl mx-auto px-4 py-6">
  <h1 class="text-2xl font-semibold text-center mb-6 text-blue-800">投稿一覧</h1>
  
  <div class="space-y-4">
    <% @posts.each do |post| %>
      <div class="bg-white p-4 border border-gray-200 rounded-lg shadow hover:shadow-md hover:border-blue-400 transition duration-300">
        <h2 class="text-lg font-medium text-blue-700"><%= post.topic.title %></h2>
        <p class="text-gray-800 my-2"><%= post.content %></p>
        <div class="text-sm text-gray-500">
          <%= post.created_at.strftime("%Y年%m月%d日") %>
        </div>
      </div>
    <% end %>
  </div>
</div>