<div class="max-w-4xl mx-auto px-4 py-6">
  <h1 class="text-2xl font-bold text-center mb-6">投稿一覧</h1>
  
  <div class="space-y-4">
    <% @posts.each do |post| %>
<%# card - カードの基本コンテナ
card-body - カードの本文部分を定義する
card-title - カードのタイトル要素（ここではトピックのタイトル）
card-actions - アクション要素を配置するための領域（ここでは日付バッジ） %>
      <div class="card bg-base-100 shadow-md hover:shadow-lg transition-shadow duration-300">
        <div class="card-body">
          <h2 class="card-title text-primary"><%= post.topic.title %></h2>
          <p><%= post.content %></p>
          <%# justify-endと組み合わせることで、バッジがカードの右端 %>
          <div class="card-actions justify-end">
            <div class="badge badge-outline"><%= post.created_at.strftime("%Y年%m月%d日") %></div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>