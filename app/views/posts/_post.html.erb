<%# ---本ファイルは「投稿1件分」の設計部品を表す_パーシャルファイル、繰り返しindex.html内で使われる --- %>
<%# また本ファイルも別のファイルを呼びだしている、全体は三層構造になっている %>

<%# card - カードの基本コンテナ %>
<%#重要！！ dom_id(post) はTurboがこの全体を特定するために追加されている %>
<div
  class="
    card bg-base-100 shadow-md hover:shadow-lg transition-shadow duration-300
  "
  id="<%= dom_id(post) %>"
>

  <%# card-body - カードの本文部分を定義する %>
  <div class="card-body">

    <%# card-title - カードのタイトル要素（ここではトピックのタイトル） %>
    <h2 class="card-title text-primary"><%= post.topic.title %></h2>

    <%# 100字までtruncateで切り取り省略表示し、全文はdaisyUIモーダルで展開 %>
    <div class="mb-4 flex flex-col gap-2">
      <span><%= simple_format(truncate(post.content, length: 100)) %></span>
      <% if post.content.length > 100 %>
        <button
          type="button"
          class="link link-primary"
          onclick="document.getElementById('modal-<%= post.id %>').showModal()"
        >
          続きを読む
        </button>
      <% end %>
      <%# モーダルを開くためのボタン（daisyUI推奨のlabel+input方式） %>

    </div>

    <%# daisyUIモーダル本体 - 各投稿ごとにユニークなIDを使う %>
    <%# idはmodal-〇〇 %>
    <dialog id="modal-<%= post.id %>" class="modal">
      <div class="modal-box max-w-2xl relative">
        <button
          form="modal-<%= post.id %>"
          class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
          aria-label="閉じる"
          type="button"
          onclick="this.closest('dialog').close()"
        >
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
        <div class="prose max-w-none mb-4 mt-8">
          <%= simple_format(post.content) %>
        </div>
      </div>
      <%# モーダル背景をクリックしても閉じる %>
      <label class="modal-backdrop" for="modal-<%= post.id %>"></label>
    </dialog>

    <%# card-actions - アクション要素を配置するための領域 %>
    <%# flex justify-betweenで横並び両橋揃え、、縦方向中央揃え %>
    <div class="card-actions flex justify-between items-center">
      <%# ユーザー名 左寄せ %>
      <%# 文字の色は不透明度70% %>
      <div class="flex items-center text-sm text-base-content/70">
        <i class="fa-solid fa-user mr-1"></i><%= post.user.name %>
      </div>
      <%# いいね機能・日付 右寄せ %>
      <div class="flex items-center gap-8">
        <%# いいね機能の表示エリア。Turbo StreamがこのIDを目印にこの部分だけページ更新をせずに部分更新 %>
        <%# dom_idヘルパーメソッド、idを生成する。id = post_idnum_like_buttonを作成 %>
        <%# 暫定的にlike_buttonを文字リテラルに変更 %>
        <%# ここで部品テンプレを呼び出す、第一引数でファイル名指定、第二postオブジェクト入りの引数を渡す %>
        <%= render "likes/like_button", post: post %>
        <%# 日付のバッジ %>
        <div
          class="
            badge bg-base-100 text-sm text-base-content font-medium px-3 py-1 rounded-full
            shadow-sm
          "
        >
          <%= post.created_at.strftime("%Y年%m月%d日") %>
        </div>
      </div>
    </div>
    <%# card-actionsの閉じタグ %>
  </div>
  <%# card-bodyの閉じタグ %>
</div>
<%# cardの閉じタグ %>
