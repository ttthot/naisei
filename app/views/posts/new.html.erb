<%# filepath: /app/app/views/posts/new.html.erb %>
<div class="max-w-2xl mx-auto px-4 py-6">
  
  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <%= form_with(model: @post, local: true) do |form| %>
        <% if @post.errors.any? %>
          <div role="alert" class="alert alert-error mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div>
              <h4 class="font-bold">エラーが発生しました（<%= @post.errors.count %>件）</h4>
              <ul>
                <% @post.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <div class="card bg-base-200 w-full mb-4">
          <div class="card-body">
            <p class="text-lg"><%= @random_topic.title %></p>
            <%= form.hidden_field :topic_id, value: @random_topic.id %>
          </div>
        </div>

        <div class="w-full mb-4">
          <%# form-controlは入力フィールドとそのラベルをグループ化し、適切に配置する %>
          <label class="form-control w-full">
            <%# <div class="label">
              <span class="label-text">投稿内容</span>
            </div> %>
            <%= form.text_area :content, class: "textarea textarea-bordered h-200 w-full", placeholder: "ここに投稿内容を入力してください" %>
          </label>
        </div>

        <%#  クラス名 "card-actionsクラスは、カード内のボタンやリンクに適切なマージンやパディングを提供
         "justify-end" は、アクション要素を右端に揃えるためのユーティリティクラスです。 %>
        <div class="card-actions justify-end">
          <%# <%= link_to "一覧へ", posts_path, class: "btn btn-ghost" %> 
          <%= form.submit "投稿する", class: "btn btn-primary btn-xl" %>
        </div>
      <% end %>
    </div>
  </div>
</div>