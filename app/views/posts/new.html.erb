<div class="max-w-2xl mx-auto px-4 py-8">
  <div
    class="
      card bg-base-100 shadow-2xl rounded-2xl border border-base-300/60 relative
    "
  >
    <%= link_to posts_path, class: "btn btn-sm btn-circle btn-ghost absolute right-2 top-2 z-10" do %>
      ✕
    <% end %>
    <%# space-y-8 は子要素の間隔を空けるためのクラス %>
    <div class="card-body px-6 py-8">
      <%# 以下 ERB (Embedded Ruby) 、テンプレートエンジンによりrubyが実行されhtmlが出力される %>
      <%# form_withは、@postが新規なら/postsにPOSTで送信するHTMLフォームを生成すると規定されている %>
      <%= form_with(model: @post, data: { turbo: false }, html: { class: "space-y-10" }) do |form| %>
        <%#----%ポストした時にエラーが発生した場合 (  validates :content, presence: true)が設定されているため %>
        <% if @post.errors.any? %>
          <%# alertコンポーネント縦表示不可のためcardコンポーネントを使用してエラー表示 %>
          <div class="card bg-error text-error-content shadow-lg mb-8">
            <%# card-body以下クラスは自動パディング %>
            <div class="card-body p-4">
              <%# タイトル表示 %>
              <div class="card-title text-lg">エラーが発生しました</div>
              <%# リスト表示 %>
              <ul class="list-disc list-inside">
                <%# errors属性は自動的にpostインスタンスに入る %>
                <% @post.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>

        <% end %>
        <%# ------ここまでエラー表示ーー %>

        <%# 感情選択欄 %>
        <div class="space-y-2 mt-2">
          <%= form.label :emotion, "一番近い感情を選んでください", class: "label" %>
          <div class="grid grid-cols-2 md:grid-cols-5 gap-2">
            <%= form.collection_radio_buttons(:emotion, Post.emotions.keys, :to_s, :to_s) do |b| %>
              <label class="btn btn-lg btn-outline w-full normal-case rounded-full ">
                <%#  : インラインイベントハンドラーを削除  onchange=,,, %>
                <%= b.radio_button(class: "hidden") %>
                <span class="text-2xl">
                  <%= case b.value
                  when "neutral"
                    "😐"
                  when "happy"
                    "😊"
                  when "sad"
                    "😢"
                  when "angry"
                    "😠"
                  when "excited"
                    "🎉"
                  end %>
                </span>
              </label>
            <% end %>
          </div>
        </div>
        <%# JSは app/javascript/application.js に移動済み %>

        <%# 感情強度欄 %>
        <%# post.rbで定義済みの感情表現 %>
        <div class="form-control w-full">
          <%# form_withヘルパーではフィールド名からHTML IDを生成する際、モデル名をつける %>
          <label class="label" for="post_emotion_rating">
            <span class="label-text">感情の強さ</span>
          </label>
          <br>

          <%# form.range_field,,,はフォルムヘルパーhtmlのinput type=rangeに変換される %>
          <%= form.range_field :emotion_rating,
                           min: 1,
                           max: 5,
                           value: 3,
                           # 長さは 親要素に合わせる
                           class: "range range-success w-full",
                           step: 1 %>
          <%# メモリ線 %>
          <div class="flex justify-between px-2.5 mt-2 text-xs">
            <span>1</span>
            <span>2</span>
            <span>3</span>
            <span>4</span>
            <span>5</span>
          </div>
        </div>

        <%# お題表示はユーザー設定が設定をオンにしているかつとランダムお題が存在 %>
        <%# titleはnull制約なしなのでなくても問題なし %>
        <% if current_user&.show_topic_title? && @random_topic&.title.present? %>
          <div class="card bg-base-200 w-full mb-4 mt-4">
            <div class="card-body">
              <%# .title お題はランダムで提示 %>
              <p class="text-lg"><%= @random_topic.title %></p>

              <%# お題は定数変更不可なので hidden を使用　ユーザーは変更できない %>
              <%#　form.hidden_fieldは name属性を生成、name: post[topic_id] %>
              <%# value属性を生成、value: @random_topic.id %>
              <%# 送信時 rails内のparams,  params[:post][:topic_id] に入る %>
              <%= form.hidden_field :topic_id, value: @random_topic.id %>
            </div>
          </div>
        <% end %>

        <%# 感情を文章で表現する欄 %>
        <div class="w-full mb-4">
          <label class="form-control w-full">
            <%= form.text_area :content,
                           class: "textarea textarea-bordered h-100 w-full",
                           placeholder:
                             (
                               if current_user&.show_topic_title? &&
                                    @random_topic&.title.present?
                                 "ここにあなたの気持ちを300字以内で入力してみましょう"
                               else
                                 "今日の出来事をできるだけ詳しく書いてください。\n\nその出来事に浸り、その経験について抱いたあらゆる感情や考えを自由に表現してください。\n\n書く際は、句読点や文法を気にせず、ただ心を解き放ち、その経験についてできる限り詳しく書いてください。"
                               end
                             ),
                           id: "emotion_content" %>
          </label>
        </div>
        <%# 送信ボタンエリア %>
        <%# クラス名 "card-actionsクラスは、カード内のボタンやリンクに適切なマージンやパディングを提供 %>
        <%# "justify-end" は、アクション要素を右端に揃えるためのユーティリティクラスです。 %>
        <div class="card-actions justify-end">
          <%# デフォルトはname="commit" なので params[:commit]でvalueが取得可能 %>
          <%# <%= button_tag "投稿", %>
          <%# type: "submit", %>
          <%# name: "commit", %>
          <%# value: "post", %>
          <%# class: "btn btn-primary btn-xl" %>

          <%= button_tag "投稿とアドバイス",
          type: "submit",
          name: "commit",
          value: "post_and_aiadvice",
          class: "btn btn-primary btn-xl",
          id: "submit_btn",
          disabled: true %>
        </div>
      <% end %>
    </div>
  </div>
</div>
