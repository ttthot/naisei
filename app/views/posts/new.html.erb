<%# filepath: /app/app/views/posts/new.html.erb %>
<div class="max-w-2xl mx-auto px-4 py-6">
  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <%# 以下 ERB (Embedded Ruby) 、テンプレートエンジンによりrubyが実行されhtmlが出力される %>
      <%# form_withは、@postが新規なら/postsにPOSTで送信するHTMLフォームを生成すると規定されている %>
      <%= form_with(model: @post, data: { turbo: false }) do |form| %>
        <%# --%ポストした時にエラーが発生した場合 (  validates :content, presence: true)が設定されているため %>
        <% if @post.errors.any? %>
          <%# alertコンポーネント縦表示不可のためcardコンポーネントを使用してエラー表示 %>
          <div class="card bg-error text-error-content shadow-lg mb-8">
            <%# card-body以下クラスは自動パディング %>
            <div class="card-body p-4">
              <%# タイトル表示 %>
              <div class="card-title text-lg">エラーが発生しました（<%= @post.errors.count %>件）</div>
              <%# リスト表示 %>
              <ul class="list-disc list-inside">
                <%# errors属性は自動的にpostインスタンスに入る %>
                <% @post.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>

        <% end %>
        <%# ーーここまでーー %>

        <%# 感情選択欄 %>
        <div class="flex flex-wrap gap-4 mt-2">
          <div class="w-full">
            <%= form.label :emotion, "感情を記入しましょう", class: "label" %>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
              <%# form_with内で@postを渡すこれを元に　name="post[属性名]"を出力、今回はpost[emotion] %>
              <%= form.collection_radio_buttons(:emotion, Post.emotions.keys, :to_s, :to_s) do |b| %>
                <%# 背景色は透明のボタン %>
                <label class="btn btn-outline w-full normal-case">
                  <%= b.radio_button(class: "hidden", onchange: "updateButtons('post[emotion]')") %>
                  <%# 感情に対応する絵文字を表示,文字サイズは顔文字のサイズを示す %>
                  <span class="text-2xl">
                    <%= case b.value
                    when "neutral"
                      "😐"
                    when "happy"
                      "😊"
                    when "sad"
                      "😢"
                    when "angry"
                      "😠"
                    when "excited"
                      "🎉"
                    end %>
                  </span>
                </label>
              <% end %>
            </div>
          </div>
        </div>

        <script>
  // すべてのラジオボタングループを更新する関数
  function updateButtons(groupName) {
    // 以下の条件に一致するラジオボタン
    // 要素名input, type属性がradioで、name属性が関数に渡されたgroupNameの値であるもの
    const radios = document.querySelectorAll(`input[type="radio"][name="${groupName}"]`);
    
    // 1---すべてのラベルをリセット
    // 取得したすべてのラジオボタンの親要素のクラスを更新
    // 親要素のクラスからbtn-primaryを削除し、btn-outline透明背景を追加
    radios.forEach(radio => {
      radio.parentElement.classList.remove('btn-primary');
      radio.parentElement.classList.add('btn-outline');
    });
    
    // 2---選択されているラジオボタンのラベルを更新
    radios.forEach(radio => {
      // inputelementに搭載のcheckedプロパティがtrue
      if (radio.checked) {
        radio.parentElement.classList.remove('btn-outline');
        radio.parentElement.classList.add('btn-primary');
      }
    });
  }
  
  // ボタンがクリックされたときとDOM構築完了後、上記定義の関数が実行される
  // DOM構築完了後に実行、つまりページが読み込まれた後
  // element.addEventListener(event, function, capture)
  document.addEventListener('DOMContentLoaded', function() {
    updateButtons('post[emotion]');
  });
        </script>
        <%# 感情強度欄 %>
        <%# post.rbで定義済みの感情表現 %>
        <div class="form-control w-full max-w-xs">
          <%# form_withヘルパーではフィールド名からHTML IDを生成する際、モデル名をつける %>
          <label class="label" for="post_emotion_rating">
            <span class="label-text">感情の強さ</span>
          </label>
          <br>

          <%# form.range_field,,,はフォルムヘルパーhtmlのinput type=rangeに変換される %>
          <%= form.range_field :emotion_rating,
                           min: 1,
                           max: 5,
                           value: 3,
                           class: "range range-success w-full",
                           step: 1 %>
          <%# メモリ線 %>
          <div class="flex justify-between px-2.5 mt-2 text-xs">
            <span>1</span>
            <span>2</span>
            <span>3</span>
            <span>4</span>
            <span>5</span>
          </div>
        </div>

        <%# お題表示欄 - 感情強度欄の下に移動 %>
        <div class="card bg-base-200 w-full mb-4 mt-4">
          <div class="card-body">
            <%# .titleお題はランダムで提示 %>
            <p class="text-lg"><%= @random_topic.title %></p>
            <%# お題は定数変更不可なのでhiddenを使用 %>
            <%# name属性を生成、　name: post[topic_id] %>
            <%# value属性を生成、value: randamid具体値 %>
            <%# 送信時railsはハッシュの入れ子構造　、params[:post][:topic_id]　= "数値"を受け取る %>
            <%# どのモデルのどのデータを受け取る %>
            <%= form.hidden_field :topic_id, value: @random_topic.id %>
          </div>
        </div>

        <%# 感情を文章で表現する欄 %>
        <div class="w-full mb-4">
          <%# form-controlは入力フィールドとそのラベルをグループ化し、適切に配置する %>
          <label class="form-control w-full">
            <%= form.text_area :content,
                           class: "textarea textarea-bordered h-200 w-full",
                           placeholder: "ここに投稿内容を入力してください" %>
          </label>
        </div>

        <%# 送信ボタンエリア %>
        <%# クラス名 "card-actionsクラスは、カード内のボタンやリンクに適切なマージンやパディングを提供 %>
        <%# "justify-end" は、アクション要素を右端に揃えるためのユーティリティクラスです。 %>
        <div class="card-actions justify-end">
          <%# デフォルトはname="commit" なので params[:commit]でvalueが取得可能 %>
          <%= button_tag "投稿",
          type: "submit",
          name: "commit",
          value: "post",
          class: "btn btn-primary btn-xl" %>

          <%= button_tag "投稿とアドバイス",
          type: "submit",
          name: "commit",
          value: "post_and_aiadvice",
          class: "btn btn-primary btn-xl" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
