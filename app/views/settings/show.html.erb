<%# 本ページでは設定が行われた際にフラッシュメッセージ出力しない %>
<% content_for :suppress_flash, true %>
<div class="container mx-auto p-4 max-w-2xl">
  <h1 class="text-2xl font-bold mb-8 text-center">設定</h1>

  <%# LINE友だち追加 %>
  <div class="card bg-base-100 shadow-xl mb-6">
    <div class="card-body text-center">
      <h2 class="card-title justify-center mb-4">LINE通知で習慣にしましょう！</h2>
      <div class="flex justify-center mb-4">
        <a href="https://lin.ee/OhYePqR">
          <img
            src="https://scdn.line-apps.com/n/line_add_friends/btn/ja.png"
            alt="友だちに追加"
            height="36"
          >
        </a>
      </div>

    </div>
  </div>

  <%# 統一設定フォーム開始 %>
  <%= form_with model: current_user, url: settings_path, method: :patch, local: true, id: "settings-form" do |form| %>





    <%# 習慣設定フォーム %>
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title justify-center mb-6">習慣設定</h2>

        <%# いつ日記を書くか %>
        <div class="form-control mb-6">
          <label class="label">
            <span class="label-text text-lg font-bold">いつ日記を書きますか？</span>
          </label>

          <div class="dropdown dropdown-bottom w-full">
            <div
              tabindex="0"
              role="button"
              class="btn btn-outline w-full justify-between"
              id="trigger-btn"
            >
              <span id="trigger-selected"></span>
              <i class="fas fa-chevron-down w-4 h-4"></i>
            </div>

            <ul
              tabindex="0"
              class="
                dropdown-content z-[1] menu p-2 shadow bg-base-100 rounded-box w-full border
                border-base-200
              "
            >
              <% User::DIARY_TRIGGER_OPTIONS.each do |value| %>
                <li>
                  <a href="#" class="trigger-option" data-value="<%= value %>">
                    <%= value %>
                  </a>
                </li>
              <% end %>
            </ul>

            <%= form.hidden_field :diary_trigger_action,
                              id: "trigger-hidden",
                              value: current_user.diary_trigger_action %>
          </div>
        </div>

        <%# ご褒美 %>
        <div class="form-control mb-6">
          <label class="label">
            <span class="label-text text-lg font-bold">完了後のご褒美は？</span>
          </label>

          <div class="dropdown dropdown-bottom w-full">
            <div
              tabindex="0"
              role="button"
              class="btn btn-outline w-full justify-between"
              id="reward-btn"
            >
              <span id="reward-selected"></span>
              <i class="fas fa-chevron-down w-4 h-4"></i>
            </div>

            <ul
              tabindex="0"
              class="
                dropdown-content z-[1] menu p-2 shadow bg-base-100 rounded-box w-full border
                border-base-200
              "
            >
              <% User::DIARY_REWARD_OPTIONS.each do |value| %>
                <li>
                  <a href="#" class="reward-option" data-value="<%= value %>">
                    <%= value %>
                  </a>
                </li>
              <% end %>
            </ul>

            <%= form.hidden_field :diary_reward,
                              id: "reward-hidden",
                              value: current_user.diary_reward %>
          </div>
        </div>

        <%# 事前準備 %>
        <div class="form-control mb-6">
          <label class="label">
            <span class="label-text text-lg font-bold">どんなことに気をつければ日記を続けられる？</span>
          </label>

          <div class="dropdown dropdown-bottom w-full">
            <div
              tabindex="0"
              role="button"
              class="btn btn-outline w-full justify-between"
              id="preparation-btn"
            >
              <span id="preparation-selected"></span>
              <i class="fas fa-chevron-down w-4 h-4"></i>
            </div>

            <ul
              tabindex="0"
              class="
                dropdown-content z-[1] menu p-2 shadow bg-base-100 rounded-box w-full border
                border-base-200 max-h-60 overflow-y-auto
              "
            >
              <% User::DIARY_PREPARATION_OPTIONS.each do |value| %>
                <li>
                  <a href="#" class="preparation-option" data-value="<%= value %>">
                    <%= value %>
                  </a>
                </li>
              <% end %>
            </ul>

            <%= form.hidden_field :diary_preparation,
                              id: "preparation-hidden",
                              value: current_user.diary_preparation %>
          </div>
        </div>

      </div>
    </div>

    <%# 投稿方式設定 %>
    <div class="card bg-base-100 shadow-xl mt-6">
      <div class="card-body">
        <h2 class="card-title justify-center mb-6">投稿方式設定</h2>

        <div class="form-control">
          <label class="label cursor-pointer justify-start gap-4">
            <%# show_topic_titleのtrue false切り替えする %>
            <%= form.check_box :show_topic_title,
                           class: "checkbox checkbox-primary",
                           id: "topic-checkbox" %>
            <div class="flex-1">
              <span class="label-text text-lg font-medium">お題提供を受ける</span>
              <div class="label-text-alt mt-1">チェックを外すと自由記述になります</div>
            </div>
          </label>
        </div>

      </div>
    </div>

  <% end %>
  <%# 統一設定フォーム終了 %>

</div>

<script>
document.addEventListener('turbo:load', function() {
  function setupDropdown(config) {
    const button = document.getElementById(config.buttonId);
    const text = document.getElementById(config.textId);
    const hiddenField = document.getElementById(config.hiddenId);
    const form = document.getElementById('settings-form');

    // 初期表示 エラーのため.trim()で空白除去
    const v = (hiddenField && hiddenField.value || '').trim();
    text.textContent = v ? v : (config.defaultText || '選んでください');

    // メニュー（親）に1回だけバインド（イベント委譲）
    const menu = button?.parentElement?.querySelector('.dropdown-content');
    if (!menu) return;

    menu.addEventListener('click', function(e) {
      const a = e.target.closest(config.itemSelector || 'a');
      if (!a) return;
      // <a>タグなら通常のリンク動作を停止
      e.preventDefault();

      const selectedValue = a.getAttribute('data-value');
      const selectedText  = a.textContent.trim();

      // 表示とhidden更新
      text.textContent = selectedText;
      hiddenField.value = selectedValue;
      // 即保存
      form?.requestSubmit();

      // UI整えるだけ
      button.blur();
        });
      }

      // 投稿方式選択
      const topic = document.getElementById('topic-checkbox');
      const form = document.getElementById('settings-form');
      if (topic && form) {
        topic.addEventListener('change', () => {
      form.requestSubmit(); // チェック切替で即保存
        });
      }

      // ３つ分のドロップダウンを設定
  setupDropdown({
    buttonId: 'trigger-btn',
    textId: 'trigger-selected',
    hiddenId: 'trigger-hidden',
    itemSelector: '.trigger-option'
  });

  setupDropdown({
    buttonId: 'reward-btn',
    textId: 'reward-selected',
    hiddenId: 'reward-hidden',
    itemSelector: '.reward-option'
  });

  setupDropdown({
    buttonId: 'preparation-btn',
    textId: 'preparation-selected',
    hiddenId: 'preparation-hidden',
    itemSelector: '.preparation-option',
    defaultText: '指定しない'
  });
});
</script>

