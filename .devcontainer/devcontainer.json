{
  "name": "Rails Dev",
  "dockerComposeFile": ["../docker-compose.yml", "../docker-compose.override.yml"],
  "service": "web",
  "workspaceFolder": "/app",
  //  docker が落ちるので開発環境で必要なメモリ設定を追加
  "hostRequirements": {
    "memory": "4gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "misogi.ruby-rubocop",
        "ms-azuretools.vscode-docker",
        "KoichiSasada.vscode-rdbg",
        "esbenp.prettier-vscode",
        "elia.erb-formatter",
        "bradlc.vscode-tailwindcss",
        "anthropic.claude-dev",
        "anthropic.claude-code",
        "gruntfuggly.todo-tree"
      ],

      "settings": {
        "ruby.rubocop.useBundler": true,
        "extensions.verifySignature": false,
        "terminal.integrated.shellIntegration.enabled": true,
        "terminal.integrated.suggest.enabled": true,
        "terminal.integrated.defaultLocation": "editor",

        // Rubyの設定（必要に応じて既存の設定を保持）
        "[ruby]": {
          "editor.defaultFormatter": "Shopify.ruby-lsp",
          "editor.formatOnSave": true,
          "editor.tabSize": 2,
          "editor.insertSpaces": true,
          "editor.semanticHighlighting.enabled": true,
          "editor.formatOnType": true
        },
        "rubyLsp.formatter": "rubocop",
        "rubyLsp.testTimeout": 60,
        "ruby.useLanguageServer": true,
        "ruby.lsp.enabled": true,
        "ruby.lsp.server": "ruby-lsp",

        // ERBファイルの関連付け
        "files.associations": {
          "*.erb": "erb",
          "*.html.erb": "erb"
        },

        // HTML用のPrettier設定
        "[html]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        // CSS用のPrettier設定
        "[css]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        // JavaScript用のPrettier設定
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        // JSON用のPrettier設定
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },

        // Tailwind CSS設定
        "tailwindCSS.includeLanguages": {
          "erb": "html",
          "html.erb": "html"
        },
        "tailwindCSS.emmetCompletions": true,
        "tailwindCSS.classAttributes": ["class", "className", "classList", "ngClass"],

        // Todo Tree設定
        "todo-tree.general.tags": ["TODO", "FIXME", "BUG", "HACK", "NOTE", "REVIEW", "OPTIMIZE"],
        "todo-tree.highlights.defaultHighlight": {
          "foreground": "white",
          "background": "#ffbd2a",
          "iconColour": "#ffbd2a",
          "type": "tag"
        },
        "todo-tree.highlights.customHighlight": {
          "TODO": {
            "background": "#3ea8ff",
            "iconColour": "#3ea8ff"
          },
          "FIXME": {
            "background": "#f14c4c",
            "iconColour": "#f14c4c"
          },
          "BUG": {
            "background": "#ff0000",
            "iconColour": "#ff0000"
          },
          "HACK": {
            "background": "#ff00ff",
            "iconColour": "#ff00ff"
          },
          "NOTE": {
            "background": "#2fad75",
            "iconColour": "#2fad75"
          }
        }
      }
    }
  },
  "containerEnv": {
    "VSCODE_SHELL_INTEGRATION": "1"
    // 権限の関係で/home/rails/.npm-global/bin/claude-codeに実行ファイルがあるのでパスを通す
    // "PATH": "/home/rails/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "mounts": [
    // ホストマシンの.gitconfigファイルをコンテナにマウントし、
    // それをpostCreateCommandでコピーすることでGit設定を引き継ぎます
    "source=${localEnv:HOME}/.gitconfig,target=/tmp/.gitconfig,type=bind,consistency=cached"
  ],
  // 軽量なGit設定（毎回実行）
  "postCreateCommand": "bash -c 'cp /tmp/.gitconfig ~/.gitconfig || true; git config --global pager.branch false; git config --global pager.diff false; git config --global pager.log false'",
  // bundle installのみ自動実行（サーバー起動はdocker-composeに委ねる）
  "postStartCommand": "bundle install",
  "onCreateCommand": "echo '=====================================' && echo 'DevContainer起動完了！' && echo '手動実行が必要です:' && echo '1. rails db:create (初回のみ)' && echo '2. rails db:migrate (初回のみ)' && echo 'rails serverはdocker-composeで自動起動されます' && echo '===================================='"
}
