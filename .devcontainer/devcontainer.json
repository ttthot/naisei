{
  "name": "Rails Dev",
  "dockerComposeFile": ["../docker-compose.yml", "../docker-compose.override.yml"],
  "service": "web",
  "workspaceFolder": "/app",
  //  docker が落ちるので開発環境で必要なメモリ設定を追加
  "hostRequirements": {
    "memory": "4gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "misogi.ruby-rubocop",
        "ms-azuretools.vscode-docker",
        "KoichiSasada.vscode-rdbg",
        "esbenp.prettier-vscode",
        "elia.erb-formatter",
        "bradlc.vscode-tailwindcss",
        "anthropic.claude-dev",
        "anthropic.claude-code",
        "gruntfuggly.todo-tree"
      ],

      "settings": {
        "ruby.rubocop.useBundler": true,
        "extensions.verifySignature": false,
        "terminal.integrated.shellIntegration.enabled": true,
        "terminal.integrated.suggest.enabled": true,
        "terminal.integrated.defaultLocation": "editor",

        // Rubyの設定（必要に応じて既存の設定を保持）
        "[ruby]": {
          "editor.defaultFormatter": "Shopify.ruby-lsp",
          "editor.formatOnSave": true,
          "editor.tabSize": 2,
          "editor.insertSpaces": true,
          "editor.semanticHighlighting.enabled": true,
          "editor.formatOnType": true
        },
        "rubyLsp.formatter": "rubocop",
        "rubyLsp.testTimeout": 60,
        "ruby.useLanguageServer": true,
        "ruby.lsp.enabled": true,
        "ruby.lsp.server": "ruby-lsp",

        // ERBファイルの関連付け
        "files.associations": {
          "*.erb": "erb",
          "*.html.erb": "erb"
        },

        // HTML用のPrettier設定
        "[html]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        // CSS用のPrettier設定
        "[css]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        // JavaScript用のPrettier設定
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        // JSON用のPrettier設定
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },

        // Tailwind CSS設定
        "tailwindCSS.includeLanguages": {
          "erb": "html",
          "html.erb": "html",
          // rubyと解釈される場所でもhtmlとして認識しコード補完をする
          "ruby": "html"
        },
        "tailwindCSS.emmetCompletions": true,
        "tailwindCSS.classAttributes": [
          "class",
          "className",
          "classList",
          "ngClass",
          "alert",
          "div",
          "ul",
          "li",
          "span"
        ],

        // Todo Tree設定
        "todo-tree.general.tags": ["TODO", "FIXME", "BUG", "HACK", "NOTE", "REVIEW", "OPTIMIZE"],
        "todo-tree.highlights.defaultHighlight": {
          "foreground": "#ffffff",
          "background": "#ffbd2a",
          "iconColour": "#ffbd2a",
          "type": "tag"
        },
        "todo-tree.highlights.customHighlight": {
          "TODO": {
            "background": "#3ea8ff",
            "iconColour": "#3ea8ff"
          },
          "FIXME": {
            "background": "#f14c4c",
            "iconColour": "#f14c4c"
          },
          // バグや不具合が明確に存在する箇所
          "BUG": {
            "background": "#ff0000",
            "iconColour": "#ff0000"
          },
          // 一時的な回避策や、理想的ではない実装
          "HACK": {
            "background": "#ff00ff",
            "iconColour": "#ff00ff"
          },
          // コードの意図や設計上の理由、特別な注意点
          "NOTE": {
            "background": "#2fad75",
            "iconColour": "#2fad75"
          }
        }
      }
    }
  },
  "containerEnv": {
    "VSCODE_SHELL_INTEGRATION": "1"
    // 権限の関係で/home/rails/.npm-global/bin/claude-codeに実行ファイルがあるのでパスを通す
    // "PATH": "/home/rails/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "mounts": [
    // ホストマシンの.gitconfigファイルをコンテナにマウントし、
    // それをpostCreateCommandでコピーすることでGit設定を引き継ぎます
    "source=${localEnv:HOME}/.gitconfig,target=/tmp/.gitconfig,type=bind,consistency=cached"
  ],
  //nmp install = node_modules が 空のまま になるのを防ぐ
  "postCreateCommand": "npm install && bash -c 'cp /tmp/.gitconfig ~/.gitconfig || true; git config --global pager.branch false; git config --global pager.diff false; git config --global pager.log false'",
  // bin/dev || echo devが失敗すればその時点で終了
"postStartCommand": "bin/dev || (echo '[postStartCommand] ⚠️ bin/dev failed'; ls -la node_modules/tailwindcss || echo '[debug] tailwindcss not found'; ls -la ./app/assets/builds || true; exit 0)"
}
