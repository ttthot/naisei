{
  "name": "Rails Dev",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "web",
  "workspaceFolder": "/app",
  // JSON構文エラーの原因となる行コメントを削除しました
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "misogi.ruby-rubocop",
        "ms-azuretools.vscode-docker",
        "KoichiSasada.vscode-rdbg"
      ],
      "settings": {
        "ruby.rubocop.useBundler": true,
        "extensions.verifySignature": false,
        "terminal.integrated.shellIntegration.enabled": true,
        "terminal.integrated.suggest.enabled": true,
        "terminal.integrated.defaultLocation": "editor"
      }
    }
  },
  "containerEnv": {
    "VSCODE_SHELL_INTEGRATION": "1"
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "mounts": [
    // ホストマシンの.gitconfigファイルをコンテナにマウントし、
    // それをpostCreateCommandでコピーすることでGit設定を引き継ぎます
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig,target=/tmp/.gitconfig,type=bind,consistency=cached"
  ],
  // 以下のpostCreateCommandでは:
  // 1. bundle installでGemをインストール
  // 2. rails db:createでデータベースを作成(既存の場合はスキップ)
  // 3. ホストマシンの.gitconfig設定をコンテナにコピー
  // 4. Gitのページャーを無効化
  "postCreateCommand": "bundle install && (rails db:create || true) && cp /tmp/.gitconfig ~/.gitconfig && git config --global core.pager ''"
}
