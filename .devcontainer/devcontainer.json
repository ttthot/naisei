{
  "name": "Rails Dev",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "web",
  "workspaceFolder": "/app",
  "postCreateCommand": "bundle install && rails db:create",
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "misogi.ruby-rubocop",
        "ms-azuretools.vscode-docker",
        "KoichiSasada.vscode-rdbg"
      ],
      "settings": {
        // "ruby.rubocop.executePath": "/app/bin/",
        "ruby.rubocop.useBundler": true,  // Bundle経由で実行するよう変更
        "extensions.verifySignature": false
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  }
}
